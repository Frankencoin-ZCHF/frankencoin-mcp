{
  "name": "frankencoin-mcp",
  "version": "2.0.0",
  "description": "MCP server for Frankencoin (ZCHF) protocol — 13 consolidated tools for supply, positions, savings, FPS, challenges, analytics, governance, and more",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "frankencoin-mcp": "./src/index.js",
    "frankencoin": "./src/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "start:http": "node src/index.js --http",
    "lint": "eslint src/",
    "cli": "node src/cli.js",
    "test": "node --test src/webhooks/tests/*.test.js",
    "test:webhooks": "node --test src/webhooks/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "zod": "^3.24.2"
  },
  "keywords": [
    "frankencoin",
    "zchf",
    "mcp",
    "defi",
    "stablecoin"
  ],
  "author": "Frankencoin Association",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frankencoin-ZCHF/frankencoin-mcp"
  }
}
