{
  "name": "frankencoin-mcp",
  "version": "3.0.0",
  "description": "MCP server for Frankencoin (ZCHF) protocol — read-only data tools for supply, positions, savings, FPS, challenges, analytics, governance, risk ratings, insurance products, compliance, and more",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "bin": {
    "frankencoin-mcp": "./src/index.js",
    "frankencoin": "./src/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/index.js --http",
    "start": "node src/index.js --http",
    "start:stdio": "node src/index.js",
    "cli": "node src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "graphql": "^16.9.0",
    "zod": "^3.24.2"
  },
  "keywords": [
    "frankencoin",
    "zchf",
    "mcp",
    "defi",
    "stablecoin"
  ],
  "author": "Frankencoin Association",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frankencoin-ZCHF/frankencoin-mcp"
  }
}
