{
  "name": "frankencoin-mcp",
  "version": "4.0.1",
  "description": "MCP server for Frankencoin (ZCHF) protocol — read-only data tools for supply, positions, savings, FCS governance and underlying FPS economics, challenges, analytics, risk ratings, insurance products, compliance, and more",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "bin": {
    "frankencoin-mcp": "./src/index.js",
    "frankencoin": "./src/cli.js"
  },
  "scripts": {
    "dev": "node --watch src/index.js --http",
    "start": "node src/index.js --http",
    "start:stdio": "node src/index.js",
    "cli": "node src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "graphql": "^16.9.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "frankencoin",
    "zchf",
    "mcp",
    "defi",
    "stablecoin"
  ],
  "author": "Frankencoin Association",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frankencoin-ZCHF/frankencoin-mcp"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
