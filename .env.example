# Frankencoin MCP Server — Environment Variables
#
# Nothing is required to boot. Every variable below is optional; a missing secret
# only degrades the tool(s) that depend on it (never a hard failure).

# Port (Railway sets this automatically)
PORT=3000

# Canonical public origin, used in the /llms.txt and /api manifests
PUBLIC_URL=https://mcp.frankencoin.com

# CoinGecko Pro API key — enables full market/macro data in get_market_data
COINGECKO_API_KEY=

# Dune Analytics API key — enables get_dune_stats
DUNE_API_KEY=

# Risk ratings (get_risk) — third-party providers integrated on frankencoin.com.
# Pharos: stablecoin-safety report card. Xerberus: composite registry scores.
PHAROS_API_KEY=
XERBERUS_API_KEY=
XERBERUS_USER_EMAIL=

# Rate limiting (requests per IP per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
